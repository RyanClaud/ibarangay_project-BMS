# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
# Docker env file (contains secrets — never commit)
.env.docker
# But allow the template example
!.env.docker.example
!.env.local.example

# firebase
firebase-debug.log
firestore-debug.log

# Documentation files (exclude all .md files except README.md)
*.md
!README.md
!docs/*.md

# Allow only the essential docs that belong in the repo
docs/*.md
!docs/SYSTEM_ARCHITECTURE_TECHNICAL_DETAIL.md
!docs/PROFILING_MODULE_DESIGN.md
!docs/PROFILING_USER_GUIDE.md
!docs/INFRASTRUCTURE_LAYER.md
!docs/system-modeling-and-17-diagrams.md
!docs/PROJECT_PROPOSAL_REVISED.md

# Setup scripts (local environment only)
setup-vercel-env.ps1
setup-vercel-env.sh
*.ps1
*.sh

# Sensitive configuration files (keep config.ts but protect with env vars)
.firebaserc
firebase.json
firestore.rules
storage.rules
firestore.indexes.json
apphosting.yaml

# Setup and configuration text files
*.txt
!robots.txt

# CSV data files (may contain sensitive information)
*.csv

# Public HTML utilities (may contain sensitive scripts)
public/*.html
!public/offline.html

# PWA files
public/sw.js
public/workbox-*.js
public/worker-*.js
public/sw.js.map
public/workbox-*.js.map
public/worker-*.js.map
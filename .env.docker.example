# ─────────────────────────────────────────────────────────────────────────────
# iBarangay — Docker Environment Template
#
# STEP 1  Copy this file:
#           cp .env.docker.example .env.docker
#
# STEP 2  Fill in your Firebase credentials (see HOW TO GET VALUES below).
#
# STEP 3  Build & run:
#           docker compose up --build
#
# The app will be available at  http://localhost:3000
#
# NEVER commit .env.docker to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Firebase Client SDK (browser-side) ───────────────────────────────────────
# Source: Firebase Console → Project Settings → Your Apps → Web app → Config
#
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ── Firebase Admin SDK (server-side, never sent to browser) ──────────────────
# Source: Firebase Console → Project Settings → Service Accounts
#         → "Generate new private key" → download JSON → copy values below
#
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the private key exactly as it appears in the JSON file.
# Keep the quotes. Replace literal \n characters with actual newlines if needed.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key content here\n-----END PRIVATE KEY-----\n"


# ── Google Gemini AI (AI Insights feature) ────────────────────────────────────
# Source: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features — the rest of the app works without it.
#
GEMINI_API_KEY=your_gemini_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET YOUR FIREBASE VALUES
# ─────────────────────────────────────────────────────────────────────────────
#
#  Client SDK values (NEXT_PUBLIC_FIREBASE_*):
#   1. Go to https://console.firebase.google.com
#   2. Select your project (or create one)
#   3. Click the gear icon → Project Settings
#   4. Scroll to "Your apps" → click the web app (</>)
#   5. Copy the firebaseConfig object values
#
#  Admin SDK values (FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY):
#   1. Same Project Settings page → Service Accounts tab
#   2. Click "Generate new private key"
#   3. Open the downloaded JSON file
#   4. FIREBASE_PROJECT_ID     = project_id
#   5. FIREBASE_CLIENT_EMAIL   = client_email
#   6. FIREBASE_PRIVATE_KEY    = private_key (keep the quotes and \n characters)
#
#  First-time Firebase project setup:
#   1. Enable Authentication → Email/Password provider
#   2. Create a Firestore database (start in test mode, then deploy rules)
#   3. Enable Storage
#   4. After the app starts, visit http://localhost:3000/initial-setup
#      to create the first Super Admin account
# ─────────────────────────────────────────────────────────────────────────────
